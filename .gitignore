# ----------------------------------------------------------
uploads/
storage/
tmp/
temp/
.cache/
converted/

# ----------------------------------------------------------
# Logs
# ----------------------------------------------------------
logs/
*.log

# ----------------------------------------------------------
# Graphify (knowledge graph)
# ----------------------------------------------------------
# graphify-out/ É versionado de propósito: o time inteiro começa com o mapa
# pronto. Só o custo local e o cache ficam de fora.
graphify-out/cost.json
graphify-out/cache/
# Caminhos absolutos desta máquina — quebram o sync casa <-> trabalho.
graphify-out/.graphify_python
graphify-out/.graphify_root

# Clone do código-fonte do graphify (repo git aninhado — a instalação
# funcional veio do PyPI). Remova esta linha se deletar a pasta.
/graphify/

# ----------------------------------------------------------
# Claude Code
# ----------------------------------------------------------
# .claude/ (skills, hooks, CLAUDE.md) é versionado e compartilhado.
# Apenas as configurações locais da máquina ficam de fora.
.claude/settings.local.json

