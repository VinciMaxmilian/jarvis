# Contrato de configuração do Jarvis. Copie para `.env` e preencha:
#   cp .env.example .env
# Toda variável declarada em packages/shared/settings.py entra aqui no mesmo commit.
# Este arquivo é VERSIONADO — nunca coloque segredo real nele.

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
ENVIRONMENT=dev                 # dev | prod — opcional, default dev
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR — opcional, default INFO

# ---------------------------------------------------------------------------
# Postgres — consumido pelo docker-compose para criar o banco
# ---------------------------------------------------------------------------
POSTGRES_USER=jarvis            # usuário do container postgres — obrigatório
POSTGRES_PASSWORD=troque-esta-senha  # senha do container postgres — obrigatório, troque
POSTGRES_DB=jarvis              # nome do banco criado no primeiro boot — obrigatório

# ---------------------------------------------------------------------------
# Dados
# ---------------------------------------------------------------------------
# DSN async lido pela app; precisa começar com postgresql+asyncpg:// — obrigatório.
# Aponta para 127.0.0.1 (uso a partir do host: Alembic, pytest, psql).
# Dentro do Compose o host vira `postgres`, sobrescrito pelo próprio compose.
DATABASE_URL=postgresql+asyncpg://jarvis:troque-esta-senha@127.0.0.1:5433/jarvis
REDIS_URL=redis://127.0.0.1:6379/0   # cache e locks (v1) — opcional, tem default

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Quem serve o Chief AI por default: lmstudio | gemini | anthropic | openai | local | ollama.
# É só o default de boot; a escolha em runtime vive em system_settings (API/UI).
# Ordem de preferência em apps/api/deps.py: lmstudio → gemini → anthropic → openai → ollama.
CHIEF_PROVIDER=lmstudio

# LM Studio — servidor OpenAI-compatible rodando FORA do Docker, na LAN.
# O container alcança pelo IP da máquina; `127.0.0.1` aqui apontaria para o
# próprio container e daria connection refused.
# Confira os modelos servidos com: curl http://<ip>:1234/v1/models
LMSTUDIO_BASE_URL=http://192.168.11.189:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e2b   # verificado em GET /v1/models
LMSTUDIO_API_KEY=lm-studio          # o LM Studio ignora; o SDK da OpenAI exige algo

# Gemini (Google AI) — provider principal. Aceita GEMINI_API_KEY ou GOOGLE_API_KEY;
# se você já usa GOOGLE_API_KEY para outra ferramenta, não precisa duplicar a chave.
# Pegue em https://aistudio.google.com/apikey e NUNCA comite o valor.
GEMINI_API_KEY=
# Nome do modelo NÃO verificado contra a API (faltava chave). Confirme com
# `GET https://generativelanguage.googleapis.com/v1beta/models` antes de confiar.
GEMINI_MODEL=gemini-2.5-flash

# Só é obrigatória de verdade com CHIEF_PROVIDER=anthropic; `Settings` tem default
# dummy justamente para não exigir chave de um provider que você não vai usar.
ANTHROPIC_API_KEY=sk-ant-coloque-a-sua-chave-aqui  # opcional
OPENAI_API_KEY=sk-dummy         # usado por CHIEF_PROVIDER=openai|local — opcional
OPENAI_BASE_URL=http://127.0.0.1:1234/v1  # LM Studio/vLLM (API compatível) — opcional
CHIEF_MODEL=claude-opus-5       # modelo forte: planejamento e tool calling — opcional
CHEAP_MODEL=claude-haiku-4-5-20251001  # modelo barato: classificação/resumo — opcional
KOBOLD_URL=http://host.docker.internal:5001  # inferência local (v1), fora do Compose — opcional

# Ollama — ÚLTIMO RECURSO e FORA do Docker de propósito (ver infrastructure/README.md).
# O adapter continua no repositório e selecionável em runtime; o que saiu foi o
# serviço no compose. Instale o Ollama no host e aponte para ele:
#   host  -> http://127.0.0.1:11434
#   dentro do container -> http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434  # opcional
OLLAMA_MODEL=adelnazmy2002/Qwen3-VL-8B-Instruct  # VL: visão e texto em 4 GB — opcional

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
TAVILY_API_KEY=tvly-coloque-a-sua-chave-aqui  # busca web, a 1ª tool real da v0 — obrigatório

# ---------------------------------------------------------------------------
# Publicação e Segurança Externa (v1.5)
# ---------------------------------------------------------------------------
# Cloudflare Tunnel
#
# NENHUMA das duas é lida pela app nem pelo compose. O conector roda como
# SERVIÇO DO WINDOWS no host e lê o token de %PROGRAMDATA%\cloudflared\token,
# escrito pelo próprio `cloudflared.exe service install`. Ficam aqui só como
# registro de qual túnel esta máquina serve. Ver infrastructure/README.md §8.
#
# Onde achar: dashboard -> Networking -> Tunnels -> JARVIS_TUNNEL.
#   ID    : aba Overview, sob o nome do túnel (é um UUID).
#   TOKEN : aba Overview -> "Add a replica", que revela o comando de instalação
#           pronto; o token é o argumento do `service install`.
#
# O TOKEN É SEGREDO VIVO. Ele decodifica para {conta, UUID do túnel, segredo} e
# quem o tem levanta um conector que se apresenta como esta máquina — é uma
# porta para dentro da rede, não uma credencial de leitura. NUNCA preencha o
# valor real neste arquivo: ele é versionado. O valor real vai no `.env`.
CLOUDFLARE_TUNNEL_ID=              # UUID do túnel — opcional, só registro
CLOUDFLARE_TUNNEL_TOKEN=           # SEGREDO: só no .env, nunca aqui — opcional, só registro

# Cloudflare Access (autenticação na borda, verificada na origem)
#
# As TRÊS juntas ou nenhuma: preencher só uma ou duas derruba o boot de
# propósito (packages/shared/settings.py). Com ENVIRONMENT=prod e as três
# vazias, o boot também cai — servir a origem sem autenticação é o único modo
# de falha proibido aqui. Em dev, vazias = gate desligado (CF_ACCESS_ENFORCE=auto).
#
# Nenhum destes três é segredo (o AUD viaja dentro do próprio JWT), mas são
# dados da conta do dono — placeholders aqui, valores reais no `.env`.
#
# Onde achar cada um no dashboard:
#   TEAM_DOMAIN : Zero Trust -> Settings -> General ("Team domain"). Aceita
#                 tanto `meutime` quanto `meutime.cloudflareaccess.com`; um
#                 validador normaliza e deriva o `iss` e a URL do JWKS.
#   AUD         : Zero Trust -> Access controls -> Applications -> Configure na
#                 aplicação -> Additional settings -> "Application Audience
#                 (AUD) Tag".
#   EMAIL       : o e-mail que está no Include da policy do Access. O claim
#                 `email` do token tem de bater exatamente (case-insensitive).
CF_ACCESS_TEAM_DOMAIN=             # ex: meutime.cloudflareaccess.com
CF_ACCESS_AUD=                     # Application Audience (AUD) tag da aplicação
CF_ACCESS_EMAIL=                   # e-mail do dono, idêntico ao da policy

# Opcionais, com default em Settings:
#   CF_ACCESS_ENFORCE=auto         # auto | on | off — auto liga com as 3 acima preenchidas
#   CF_ACCESS_JWKS_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Memória (v1.3)
# ---------------------------------------------------------------------------
LANCEDB_PATH=./data/lancedb     # diretório dos vetores (memória longa, RAG) — opcional

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1              # bind do uvicorn; no Compose vira 0.0.0.0 — opcional
API_PORT=8000                   # porta do uvicorn — opcional
# origens permitidas, separadas por vírgula — opcional.
# ATENÇÃO: sem comentário na mesma linha. O `env_file:` do Compose não corta
# comentário inline; ele injetaria o texto inteiro dentro do valor da variável.
CORS_ORIGINS=http://localhost:5173,http://tauri.localhost,tauri://localhost

# --- voz: síntese (TTS) — tudo opcional -------------------------------------
# Provider da voz na conversa por voz (/api/voice/call). `gemini` reusa a
# GEMINI_API_KEY já configurada acima e devolve PCM 24 kHz, que é o formato que
# o player do PWA espera — sem transcode. `edge` é gratuito, não pede chave e
# é SEMPRE a rede de segurança: falha, cota estourada ou chave ausente caem
# nele automaticamente, com aviso `voice.tts.fallback` no log.
TTS_PROVIDER=gemini
# Voz do Gemini. Testadas e funcionando contra a API: Kore (default), Puck,
# Charon, Zephyr, Orus. O catálogo é maior; o resto do teste bateu em HTTP 429
# antes de confirmar. Vazio = usa o default do módulo (Kore).
TTS_GEMINI_VOICE=
# Modelo de TTS. Vazio = gemini-2.5-flash-preview-tts. Existe para reagir a uma
# renomeação de modelo pelo .env, sem commit. Nome errado dá HTTP 404.
TTS_GEMINI_MODEL=
# Voz do fallback gratuito.
TTS_EDGE_VOICE=pt-BR-AntonioNeural

# ---------------------------------------------------------------------------
# COMPUTER USE — o Jarvis vê a tela, clica e digita (mcp/jarvis_windows_host/)
# ---------------------------------------------------------------------------
# Estas variáveis são lidas pelo MCP que roda NO WINDOWS (scripts/run_desktop_host.ps1),
# não pelo container. Definir aqui só tem efeito se o host carregar este .env.
#
# Onde o container procura esse servidor. Só mexa se mudar a porta.
WINDOWS_MCP_URL=http://host.docker.internal:8765/sse
#
# INTERRUPTOR MESTRE de mouse e teclado. Desligado (o padrão), o Jarvis ainda
# ENXERGA a tela — captura e inspeção continuam funcionando — mas não move nada.
# Ligar isto dá ao agente o controle da sua máquina; é decisão sua, na mão, e
# exige reiniciar o host. Não existe caminho para o modelo virar esta chave.
DESKTOP_CONTROL_ENABLED=true
# Duração máxima de uma liberação de controle, em minutos.
DESKTOP_SESSAO_MAX_MIN=30
# Teto de ações por sessão liberada. Corta laço maluco antes dos 400 cliques.
DESKTOP_MAX_ACOES_SESSAO=200
# Intervalo mínimo entre duas ações, em ms. Mantém a coisa interrompível.
DESKTOP_INTERVALO_MIN_MS=250
# Largura máxima do screenshot enviado ao modelo. Maior = mais detalhe e mais
# token por rodada; a conversão de coordenada é feita no host, não pelo modelo.
DESKTOP_LARGURA_MAX=1280
# Trilha de auditoria: toda ação com a captura de como a tela ficou.
DESKTOP_AUDIT_DIR=data/desktop_audit
# Janelas proibidas, gravadas quando você diz "nunca mexa em X".
DESKTOP_DENYLIST=data/desktop_denylist.json
