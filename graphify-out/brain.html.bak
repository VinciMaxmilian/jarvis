_test_registry_test_manifest_invalido_fica_visivel_como_disabled"},{"relation":"rationale_for","confidence":"EXTRACTED","source_file":"tests/unit/test_registry.py","source_location":"L301","weight":1.0,"_origin":"ast","confidence_score":1.0,"source":"tests_unit_test_registry_rationale_301","target":"tests_unit_test_registry_test_manifest_invalido_hoje_desaparece_em_silencio"}],"hyperedges":[],"built_at_commit":"76a5800ca2324b6458b3cc449131303b74ce25a3"};
const CLABEL = {"0":"ToolSpec","1":"ports.py","2":"deps.py","3":"App.tsx","4":"contracts.py","5":"GoalManager","6":"dependencies","7":"compilerOptions","8":"PgGoalStore","9":"devDependencies","10":"compilerOptions","11":"ToolNotFound","12":"manifest.json","13":"0001_initial_schema.py","14":"tsconfig.json","15":"packages/__init__.py","16":"api/__init__.py","17":"routers/__init__.py","18":"vite.config.ts","19":"tools/__init__.py","20":"jarvis","21":"build_brain.py","22":"ShortTermMemory","23":"What You Must Do When Invoked","24":"Jarvis — Sistema Operacional Cognitivo Pessoal","25":"1. Stack por camada","26":"Task","27":"SchedulerManager","28":"Goal","29":"chief.py","30":"history.py","31":"graphify reference: extra exports and benchmark","32":"Mapa do Repositório e Política de Documentação","33":".claude/CLAUDE.md","34":"graphify reference: query, path, explain","35":"Jarvis","36":"caveman.md","37":"React + TypeScript + Vite","38":"graphify reference: add a URL and watch a folder","39":"graphify reference: commit hook and native CLAUDE.md integration","40":"graphify reference: incremental update and cluster-only","41":"agents/README.md","42":"capabilities/README.md","43":"6c0c7a8deed0_add_system_settings_table.py","44":"graphify reference: GitHub clone and cross-repo merge","45":"graphify reference: transcribe video and audio","46":"CLAUDE.md","47":"extraction-spec.md"};

/* ═══ palette ═══ */
const PAL = ["#00e5ff","#ffb020","#4d9dff","#00ffc8","#b06bff","#ff7a3d","#7dff6f","#ff5c8a"];
const col = c => PAL[(c|0) % PAL.length];
const hex2rgb = h => [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];
const RGB = {}; PAL.forEach(h => RGB[h] = hex2rgb(h));
const rgba = (h,a) => { const c = RGB[h] || hex2rgb(h); return `rgba(${c[0]},${c[1]},${c[2]},${a})`; };

/* ═══ data ═══ */
const nodes = GRAPH.nodes.map(n => ({...n, x:0,y:0,z:0, vx:0,vy:0,vz:0, deg:0, sx:0,sy:0,sc:1,dz:0}));
const byId  = new Map(nodes.map(n => [n.id, n]));
const links = GRAPH.links.map(l => ({...l, s:byId.get(l.source), t:byId.get(l.target)}))
                         .filter(l => l.s && l.t && l.s !== l.t);
links.forEach(l => { l.s.deg++; l.t.deg++; });

const nbr = new Map(nodes.map(n => [n.id, []]));
links.forEach(l => { nbr.get(l.s.id).push({n:l.t, l}); nbr.get(l.t.id).push({n:l.s, l}); });

[...nodes].sort((a,b) => b.deg - a.deg).slice(0,10).forEach(n => n.god = true);
nodes.forEach(n => { n.r = 2.6 + Math.sqrt(n.deg) * 2.35; n.c = col(n.community); });

const comms = {};
nodes.forEach(n => { (comms[n.community] = comms[n.community] || []).push(n); });
const commIds = Object.keys(comms).map(Number).sort((a,b) => a-b);
const hiddenPaths = new Set();

/* seed on a fibonacci sphere, split by lobes */
const LOBES = [
  { p: "apps/web", x: -800, y: 0, z: -800, n: "Frontend (Web)" },
  { p: "apps/api", x: 0, y: 0, z: -800, n: "Backend (API)" },
  { p: "packages/shared", x: 800, y: 0, z: -800, n: "Shared" },
  { p: "packages/llm", x: -800, y: 0, z: 0, n: "Intelligence (LLM)" },
  { p: "packages/agents", x: 0, y: 0, z: 0, n: "Agents" },
  { p: "packages/memory", x: 800, y: 0, z: 0, n: "Memory" },
  { p: "packages/registry", x: -800, y: 0, z: 800, n: "Registry" },
  { p: "packages/scheduler", x: 0, y: 0, z: 800, n: "Scheduler" },
  { p: "tests/", x: 800, y: 0, z: 800, n: "Tests" },
  { p: "infrastructure", x: -1600, y: 0, z: 0, n: "Infrastructure" }
];
const getLobe = (n) => {
  const path = n.source_file || "";
  return LOBES.find(l => path.includes(l.p)) || { x: 0, y: 0, z: 0, n: "Core" };
};
nodes.forEach(n => n.lobe = getLobe(n));

{ const N = nodes.length, GA = Math.PI * (3 - Math.sqrt(5));
  nodes.forEach((n,i) => {
    const y = 1 - (i / (N-1)) * 2, r = Math.sqrt(Math.max(0,1-y*y)), th = GA*i;
    const R = 150 + Math.random()*20;
    n.x = Math.cos(th)*r*R + n.lobe.x;
    n.y = y*R + n.lobe.y;
    n.z = Math.sin(th)*r*R + n.lobe.z;
  });
}

/* ═══ canvas ═══ */
const cv = document.getElementById("c"), ctx = cv.getContext("2d");
let W = 0, H = 0, DPR = 1;
function resize(){
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  W = innerWidth; H = innerHeight;
  cv.width = W*DPR; cv.height = H*DPR; cv.style.width = W+"px"; cv.style.height = H+"px";
  ctx.setTransform(DPR,0,0,DPR,0,0);
}
addEventListener("resize", resize); resize();

/* ═══ camera ═══ */
let yaw = 0.4, pitch = -0.22, zoom = 1, dist = 780;
let spin = true, lobes = true, alpha = 1, showAreas = true, showEdges = true;
let panX = 0, panY = 0, panZ = 0, tgX = 0, tgY = 0, tgZ = 0;

/* ═══ physics ═══ */
function step(){
  if (alpha < 0.005) return;
  const REP = 1200, SPR = 0.02, LEN = 60;
  
  /* STOCHASTIC REPULSION: O(N) instead of O(N^2) - VERY LIGHTWEIGHT */
  /* We only check 30 random neighbors per node per frame */
  for (let i = 0; i < nodes.length; i++){
    const a = nodes[i];
    for (let k = 0; k < 30; k++){
      const randIdx = (i + k + Math.floor(Math.random() * 50)) % nodes.length;
      const b = nodes[randIdx];
      if (a === b) continue;
      
      let dx = a.x-b.x, dy = a.y-b.y, dz = a.z-b.z;
      let d2 = dx*dx + dy*dy + dz*dz;
      if (d2 > 25000) continue; /* ignore if further than ~150 units */
      if (d2 < 1) { d2 = 1; dx = Math.random()-0.5; dy = Math.random()-0.5; dz = Math.random()-0.5; }
      
      const d = Math.sqrt(d2), f = (REP / d2) / d;
      a.vx += dx*f; a.vy += dy*f; a.vz += dz*f;
      b.vx -= dx*f; b.vy -= dy*f; b.vz -= dz*f;
    }
  }
  
  /* Link springs */
  for (const l of links){
    const a = l.s, b = l.t;
    const dx = b.x-a.x, dy = b.y-a.y, dz = b.z-a.z;
    const d = Math.sqrt(dx*dx + dy*dy + dz*dz) || 1;
    const f = (d - LEN) * SPR / d;
    a.vx += dx*f; a.vy += dy*f; a.vz += dz*f;
    b.vx -= dx*f; b.vy -= dy*f; b.vz -= dz*f;
  }
  
  for (const n of nodes){
    /* Pull heavily towards their assigned area (lobe) */
    if (lobes){
      n.vx += (n.lobe.x - n.x) * 0.015;
      n.vy += (n.lobe.y - n.y) * 0.015;
      n.vz += (n.lobe.z - n.z) * 0.015;
    } else {
      /* Generic center gravity if areas are toggled off */
      n.vx -= n.x * 0.002; n.vy -= n.y * 0.002; n.vz -= n.z * 0.002;
    }
    
    n.vx *= 0.82; n.vy *= 0.82; n.vz *= 0.82; /* high friction */
    n.x += n.vx * alpha; n.y += n.vy * alpha; n.z += n.vz * alpha;
  }
  alpha *= 0.98;
}

/* ═══ projection ═══ */
function project(n){
  const x = n.x - panX, y = n.y - panY, z = n.z - panZ;
  const cy = Math.cos(yaw), sy = Math.sin(yaw);
  const x1 = x*cy - z*sy, z1 = x*sy + z*cy;
  const cp = Math.cos(pitch), sp = Math.sin(pitch);
  const y2 = y*cp - z1*sp, z2 = y*sp + z1*cp;
  const sc = (dist * zoom) / Math.max(120, dist + z2);
  n.sx = W/2 + x1*sc; n.sy = H/2 + y2*sc; n.sc = sc; n.dz = z2;
}

/* ═══ interaction state ═══ */
let hover = null, sel = null, query = "", matched = null;
const visible = n => !hiddenPaths.has(n.source_file || 'unknown');
const lit = n => {
  if (matched && !matched.has(n.id)) return false;
  return true;
};
function focusSet(){
  const f = sel || hover; if (!f) return null;
  const s = new Set([f.id]); nbr.get(f.id).forEach(e => s.add(e.n.id)); return s;
}

/* ═══ render ═══ */
let t = 0;
function draw(){
  t += 0.016;
  if (spin && !drag) yaw += 0.0016;
  panX += (tgX - panX)*0.08; panY += (tgY - panY)*0.08; panZ += (tgZ - panZ)*0.08;
  step();
  nodes.forEach(project);

  ctx.clearRect(0,0,W,H);
  /* backdrop */
  const g = ctx.createRadialGradient(W/2,H*0.48,0,W/2,H*0.48,Math.max(W,H)*0.62);
  g.addColorStop(0,"#061722"); g.addColorStop(0.55,"#030b13"); g.addColorStop(1,"#02060c");
  ctx.fillStyle = g; ctx.fillRect(0,0,W,H);

  /* containment rings */
  ctx.save(); ctx.translate(W/2,H*0.48);
  for (let i = 0; i < 3; i++){
    const rr = (230 + i*95) * zoom;
    ctx.beginPath(); ctx.ellipse(0,0,rr,rr*0.30,Math.sin(t*0.13 + i)*0.09,0,Math.PI*2);
    ctx.strokeStyle = `rgba(55,224,255,${0.08 - i*0.02})`; ctx.lineWidth = 1; ctx.stroke();
  }
  ctx.beginPath();
  ctx.arc(0,0,300*zoom, t*0.22, t*0.22 + 1.15);
  ctx.strokeStyle = "rgba(255,176,32,.16)"; ctx.lineWidth = 1.2; ctx.stroke();
  ctx.beginPath();
  ctx.arc(0,0,332*zoom, -t*0.17 + 3, -t*0.17 + 3.7);
  ctx.strokeStyle = "rgba(55,224,255,.2)"; ctx.lineWidth = 1; ctx.stroke();
  ctx.restore();

  /* area rendering */
  if (showAreas && lobes) {
    const lobesToDraw = [];
    for (let i = 0; i < LOBES.length; i++) {
      const l = LOBES[i];
      if (l.x === 0 && l.y === 0 && l.z === 0 && l.n !== "Agents" && l.n !== "Intelligence (LLM)" && l.n !== "Shared") continue;
      const tempNode = {x: l.x, y: l.y, z: l.z};
      project(tempNode);
      if (tempNode.sc > 0.05) {
        lobesToDraw.push({ ...l, sx: tempNode.sx, sy: tempNode.sy, sc: tempNode.sc, dz: tempNode.dz, i: i });
      }
    }
    lobesToDraw.sort((a,b) => b.dz - a.dz);
    for (const l of lobesToDraw) {
      const r = 320 * l.sc;
      const colHex = PAL[l.i % PAL.length];
      const cRgb = RGB[colHex];
      const g = ctx.createRadialGradient(l.sx, l.sy, 0, l.sx, l.sy, r);
      g.addColorStop(0, `rgba(${cRgb[0]},${cRgb[1]},${cRgb[2]},0.1)`);
      g.addColorStop(0.5, `rgba(${cRgb[0]},${cRgb[1]},${cRgb[2]},0.03)`);
      g.addColorStop(1, `rgba(${cRgb[0]},${cRgb[1]},${cRgb[2]},0)`);
      
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(l.sx, l.sy, r, 0, Math.PI*2);
      ctx.fill();
      
      ctx.font = `bold ${Math.max(12, 18 * l.sc)}px Consolas,Menlo,monospace`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillStyle = `rgba(${cRgb[0]},${cRgb[1]},${cRgb[2]},0.85)`;
      ctx.fillText(l.n, l.sx, l.sy - r*0.1);
    }
  }

  const fset = focusSet();

  /* edges */
  if (showEdges) {
  ctx.lineCap = "round";
  for (const l of links){
    const a = l.s, b = l.t;
    if (!visible(a) || !visible(b)) continue;
    const inF = fset ? (fset.has(a.id) && fset.has(b.id)) : true;
    const dim = (fset && !inF) || (matched && !(matched.has(a.id) || matched.has(b.id)));
    const depth = (a.dz + b.dz) / 2;
    let al = 0.16 + 0.3 * (1 - Math.min(1, Math.max(0,(depth + 420)/840)));
    if (fset && inF) al = 0.92;
    if (dim) al *= 0.13;
    const amb = l.confidence === "AMBIGUOUS", inf = l.confidence === "INFERRED";
    ctx.strokeStyle = amb ? `rgba(255,84,112,${al})`
                    : inf ? `rgba(255,176,32,${al*0.8})`
                          : `rgba(55,224,255,${al})`;
    ctx.lineWidth = (fset && inF ? 1.5 : 0.75) * Math.min(1.5, (a.sc + b.sc)/2);
    if (inf || amb){ ctx.setLineDash([3,4]); } else { ctx.setLineDash([]); }
    ctx.beginPath(); ctx.moveTo(a.sx,a.sy); ctx.lineTo(b.sx,b.sy); ctx.stroke();
  }
  ctx.setLineDash([]);
  }

  /* nodes — painter's algorithm, far first */
  const order = nodes.filter(visible).sort((a,b) => b.dz - a.dz);
  for (const n of order){
    const inF = fset ? fset.has(n.id) : true;
    const dim = (fset && !inF) || (matched && !matched.has(n.id));
    const r = n.r * n.sc * (n.god ? 1.22 : 1) * (n === sel ? 1.35 : 1);
    const a  = dim ? 0.13 : (0.42 + 0.58 * Math.min(1, Math.max(0,(420 - n.dz)/840)));

    /* halo */
    const gg = ctx.createRadialGradient(n.sx,n.sy,0,n.sx,n.sy,r*5.5);
    gg.addColorStop(0, rgba(n.c, a*0.5)); gg.addColorStop(0.42, rgba(n.c, a*0.11));
    gg.addColorStop(1, rgba(n.c, 0));
    ctx.fillStyle = gg; ctx.beginPath(); ctx.arc(n.sx,n.sy,r*5.5,0,Math.PI*2); ctx.fill();
    /* core */
    ctx.fillStyle = rgba(n.c, Math.min(1, a*1.25)); ctx.beginPath();
    ctx.arc(n.sx,n.sy,r,0,Math.PI*2); ctx.fill();
    ctx.fillStyle = `rgba(235,253,255,${a*0.85})`; ctx.beginPath();
    ctx.arc(n.sx,n.sy,r*0.42,0,Math.PI*2); ctx.fill();

    /* god ring */
    if (n.god && !dim){
      ctx.strokeStyle = `rgba(255,176,32,${0.32 + 0.2*Math.sin(t*1.7 + n.deg)})`;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(n.sx,n.sy,r*2.1, t*0.9 + n.deg, t*0.9 + n.deg + 2.1); ctx.stroke();
      ctx.beginPath(); ctx.arc(n.sx,n.sy,r*2.1, t*0.9 + n.deg + Math.PI, t*0.9 + n.deg + Math.PI + 2.1); ctx.stroke();
    }
    /* selection reticle */
    if (n === sel){
      ctx.strokeStyle = "rgba(55,224,255,.85)"; ctx.lineWidth = 1;
      const R = r + 13;
      for (let k = 0; k < 4; k++){
        const A = t*0.55 + k*Math.PI/2;
        ctx.beginPath(); ctx.arc(n.sx,n.sy,R,A,A+0.62); ctx.stroke();
      }
    }
  }

  /* labels */
  ctx.font = "9.5px Consolas,Menlo,monospace"; ctx.textAlign = "left"; ctx.textBaseline = "middle";
  for (const n of order){
    const inF = fset ? fset.has(n.id) : false;
    const show = n === sel || n === hover || inF || (matched && matched.has(n.id)) || (!fset && !matched && n.god && n.dz < 160);
    if (!show) continue;
    const r = n.r * n.sc, tx = n.sx + r + 8, ty = n.sy;
    ctx.fillStyle = "rgba(2,8,14,.72)";
    const w = ctx.measureText(n.label).width;
    ctx.fillRect(tx-3, ty-7, w+6, 14);
    ctx.fillStyle = (n === sel || n === hover) ? "#eafcff" : rgba(n.c, 0.92);
    ctx.fillText(n.label, tx, ty);
  }
  requestAnimationFrame(draw);
}

/* ═══ picking ═══ */
function pick(mx,my){
  let best = null, bd = 26;
  for (const n of nodes){
    if (!visible(n)) continue;
    if (matched && !matched.has(n.id)) continue;
    const d = Math.hypot(n.sx-mx, n.sy-my) - n.r*n.sc;
    if (d < bd){ bd = d; best = n; }
  }
  return best;
}

/* ═══ mouse ═══ */
let drag = false, lx = 0, ly = 0, moved = 0;
const tip = document.getElementById("tip");
cv.addEventListener("pointerdown", e => { drag = true; moved = 0; lx = e.clientX; ly = e.clientY; cv.classList.add("drag"); cv.setPointerCapture(e.pointerId); });
cv.addEventListener("pointerup",   e => { drag = false; cv.classList.remove("drag"); if (moved < 5){ const n = pick(e.clientX,e.clientY); select(n); } });
cv.addEventListener("pointermove", e => {
  if (drag){
    const dx = e.clientX-lx, dy = e.clientY-ly; moved += Math.abs(dx)+Math.abs(dy);
    yaw += dx*0.006; pitch += dy*0.006;
    pitch = Math.max(-1.45, Math.min(1.45, pitch));
    lx = e.clientX; ly = e.clientY;
  } else {
    const n = pick(e.clientX,e.clientY);
    if (n !== hover){ hover = n; }
    if (n){ tip.textContent = n.label; tip.style.left = (e.clientX+14)+"px"; tip.style.top = (e.clientY-9)+"px"; tip.style.opacity = 1; }
    else tip.style.opacity = 0;
  }
});
cv.addEventListener("wheel", e => { e.preventDefault(); zoom = Math.max(0.25, Math.min(4.5, zoom * (e.deltaY > 0 ? 0.9 : 1.1))); }, {passive:false});

/* ═══ panel ═══ */
const P = { el:document.getElementById("panel"), t:document.getElementById("pT"),
            tags:document.getElementById("pTags"), rows:document.getElementById("pRows"),
            why:document.getElementById("pWhy"), cx:document.getElementById("pCx"),
            cxhd:document.getElementById("pCxHd") };
const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));

function select(n){
  sel = n;
  if (!n){ P.el.classList.remove("on"); tgX = tgY = tgZ = 0; return; }
  tgX = n.x; tgY = n.y; tgZ = n.z;
  P.t.textContent = n.label;
  P.tags.innerHTML =
    `<span class="tag" style="border-color:${n.c};color:${n.c}">${esc((n.file_type||"?").toUpperCase())}</span>` +
    `<span class="tag">${esc(CLABEL[n.community] || ("CLUSTER " + n.community))}</span><span class="tag" style="border-color:#ffb020;color:#ffb020">${esc(n.lobe.n)}</span>` +
    (n.god ? `<span class="tag gd">GOD NODE</span>` : "");
  P.rows.innerHTML =
    row("ORIGEM", esc(n.source_file || "—") + (n.source_location ? " · " + esc(n.source_location) : "")) +
    row("GRAU", n.deg + " conexões") +
    row("ID", esc(n.id));
  P.why.innerHTML = n.rationale
    ? `<div class="sec">RACIONAL</div><div class="why">${esc(n.rationale)}</div>` : "";
  const es = nbr.get(n.id).slice().sort((a,b) => b.n.deg - a.n.deg);
  P.cxhd.textContent = "CONEXÕES · " + es.length;
  P.cx.innerHTML = es.map(e => {
    const c = e.l.confidence === "AMBIGUOUS" ? "amb" : e.l.confidence === "INFERRED" ? "inf" : "";
    const dir = e.l.s === n ? "→" : "←";
    return `<div class="cx ${c}" data-id="${esc(e.n.id)}"><span class="ar">${dir}</span>` +
           `<span class="rl">${esc(e.l.relation)}</span><span class="lb">${esc(e.n.label)}</span></div>`;
  }).join("");
  P.cx.querySelectorAll(".cx").forEach(el =>
    el.onclick = () => select(byId.get(el.dataset.id)));
  P.el.classList.add("on"); P.el.scrollTop = 0;
}
const row = (k,v) => `<div class="row"><span class="k">${k}</span><span class="v">${v}</span></div>`;
document.getElementById("pX").onclick = () => select(null);

/* ═══ legend (file explorer) ═══ */
const lgList = document.getElementById("lgList");
document.querySelector("#legend .hd").textContent = "ARQUIVOS · clique p/ ocultar · dir p/ isolar";

const tree = {};
nodes.forEach(n => {
  const path = n.source_file || "unknown";
  const parts = path.split('/');
  let curr = tree;
  for (let i = 0; i < parts.length - 1; i++) {
    const p = parts[i];
    if (!curr[p]) curr[p] = { dir: true, name: p, children: {}, count: 0 };
    curr[p].count++;
    curr = curr[p].children;
  }
  const file = parts[parts.length - 1];
  if (!curr[file]) curr[file] = { dir: false, name: file, count: 0, path: path, c: n.c, n: n };
  curr[file].count++;
});

function buildTree(obj, depth=0) {
  const keys = Object.keys(obj).sort((a,b) => {
    if (obj[a].dir && !obj[b].dir) return -1;
    if (!obj[a].dir && obj[b].dir) return 1;
    return a.localeCompare(b);
  });
  let html = "";
  for (const k of keys) {
    const node = obj[k];
    if (node.dir) {
      const open = depth < 1 ? "open" : "";
      html += `<details ${open}><summary><span class="dir-name">🗀 ${esc(node.name)}</span> <span class="ct" style="opacity:0.4; font-size:8px">${node.count}</span></summary>`;
      html += `<div>${buildTree(node.children, depth+1)}</div>`;
      html += `</details>`;
    } else {
      let icon = "📄";
      if (node.name.endsWith(".py")) icon = "🐍";
      else if (node.name.endsWith(".ts") || node.name.endsWith(".tsx")) icon = "⚛️";
      else if (node.name.endsWith(".md")) icon = "📓";
      else if (node.name.endsWith(".json")) icon = "🔧";
      
      html += `<div class="lg file" data-p="${esc(node.path)}" style="color:${node.c}; transition:0.1s;">`;
      html += `<span class="nm">${icon} ${esc(node.name)}</span>`;
      if (node.count > 1) {
          html += `<span class="ct" style="opacity:0.4; font-size:8px">(${node.count} nós)</span>`;
      }
      html += `</div>`;
    }
  }
  return html;
}

lgList.innerHTML = buildTree(tree);

lgList.querySelectorAll(".file").forEach(el => {
  el.onclick = (e) => {
    const p = el.dataset.p;
    if (hiddenPaths.has(p)) hiddenPaths.delete(p);
    else hiddenPaths.add(p);
    
    el.classList.toggle("off", hiddenPaths.has(p));
    if (sel && hiddenPaths.has(sel.source_file || 'unknown')) select(null);
    alpha = Math.max(alpha, 0.35);
  };
  
  el.oncontextmenu = (e) => {
    e.preventDefault();
    const p = el.dataset.p;
    nodes.forEach(n => {
       const np = n.source_file || 'unknown';
       if (np !== p) hiddenPaths.add(np);
       else hiddenPaths.delete(np);
    });
    lgList.querySelectorAll(".file").forEach(fel => {
       fel.classList.toggle("off", hiddenPaths.has(fel.dataset.p));
    });
    if (sel && hiddenPaths.has(sel.source_file || 'unknown')) select(null);
    alpha = Math.max(alpha, 0.5);
  };
});

/* ═══ search ═══ */
const q = document.getElementById("q");
q.oninput = () => {
  query = q.value.trim().toLowerCase();
  if (!query){ matched = null; return; }
  matched = new Set(nodes.filter(n =>
    n.label.toLowerCase().includes(query) ||
    (n.source_file||"").toLowerCase().includes(query) ||
    (n.rationale||"").toLowerCase().includes(query)
  ).map(n => n.id));
};

/* ═══ controls ═══ */
const bL = document.getElementById("bLobe"), bS = document.getElementById("bSpin");
bL.onclick = () => { lobes = !lobes; bL.classList.toggle("on", lobes); alpha = Math.max(alpha, 0.5);
                     document.getElementById("mMode").textContent = lobes ? "MAPA" : "NEBULA"; };
bS.onclick = () => { spin = !spin; bS.classList.toggle("on", spin); };
const bShowAreas = document.getElementById("bShowAreas");
if(bShowAreas) bShowAreas.onclick = () => { showAreas = !showAreas; bShowAreas.classList.toggle("on", showAreas); };
const bShowEdges = document.getElementById("bShowEdges");
if(bShowEdges) bShowEdges.onclick = () => { showEdges = !showEdges; bShowEdges.classList.toggle("on", showEdges); };
document.getElementById("bReal").onclick = () => {
  alpha = 1; nodes.forEach(n => { n.vx += (Math.random()-0.5)*8; n.vy += (Math.random()-0.5)*8; n.vz += (Math.random()-0.5)*8; });
};
addEventListener("keydown", e => {
  if (e.key === "Escape"){ select(null); q.value = ""; query = ""; matched = null; q.blur(); }
  if (e.key === " " && document.activeElement !== q){ e.preventDefault(); bS.click(); }
});

/* ═══ boot ═══ */
document.getElementById("sN").innerHTML = nodes.length;
document.getElementById("sE").innerHTML = links.length;
document.getElementById("sC").innerHTML = commIds.length;
document.getElementById("mCommit").textContent = (GRAPH.built_at_commit || "—").slice(0,7);
for (let i = 0; i < 260; i++) step();
draw();
</script>
</body>
</html>
